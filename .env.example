# Copy to .env (git-ignored) and fill in locally. NEVER commit real values.
# Do NOT put real values in this file: it is committed to a public repo.
# SQL Server connection details come from Internal IT / DBA (Master Spec §18).
# Read by backend/app/db/config.py.

# Required
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Optional (defaults shown)
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
# Set to yes only if the server's certificate is self-signed / not trusted by
# this machine (check_db_connection.py reports TlsCertificateError). Traffic
# stays encrypted; the server's identity is not verified. See the directive.
DB_TRUST_SERVER_CERTIFICATE=no
DB_CONNECT_TIMEOUT_S=30
DB_QUERY_TIMEOUT_S=120

# --- Basecamp API (REQ-004, REQ-012). Read by backend/app/basecamp/config.py ---
# OAuth 2.0 access token from Basecamp's Launchpad flow (needs a registered
# Basecamp app). Required
BASECAMP_ACCOUNT_ID=
BASECAMP_ACCESS_TOKEN=
# Basecamp rejects requests without a User-Agent naming the app and a contact,
# e.g. Stress Test Review App (you@example.com)
BASECAMP_USER_AGENT=

# Optional (default shown): per-request timeout in seconds, 1-60
BASECAMP_TIMEOUT_S=15

# --- Basecamp OAuth app registration (only for backend/scripts/basecamp_oauth_setup.py) ---
# From launchpad.37signals.com/integrations. The redirect URI must match the
# registration exactly and be http://localhost:<port>/... for the setup script.
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=http://localhost:8765/basecamp/oauth/callback
# Written by the setup script; kept for refreshing the access token later.
BASECAMP_REFRESH_TOKEN=
