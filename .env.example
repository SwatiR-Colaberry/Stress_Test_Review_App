# Copy to .env (git-ignored) and fill in locally. NEVER commit real values.
# Do NOT put real values in this file: it is committed to a public repo.
# SQL Server connection details come from Internal IT / DBA (Master Spec §18).
# Read by backend/app/db/config.py.

# Required
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Optional (defaults shown)
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
# Set to yes only if the server's certificate is self-signed / not trusted by
# this machine (check_db_connection.py reports TlsCertificateError). Traffic
# stays encrypted; the server's identity is not verified. See the directive.
DB_TRUST_SERVER_CERTIFICATE=no
DB_CONNECT_TIMEOUT_S=30
DB_QUERY_TIMEOUT_S=120

# --- Basecamp API (REQ-004, REQ-012). Read by backend/app/basecamp/config.py ---
# OAuth 2.0 access token from Basecamp's Launchpad flow (needs a registered
# Basecamp app). Required
BASECAMP_ACCOUNT_ID=
BASECAMP_ACCESS_TOKEN=
# Basecamp rejects requests without a User-Agent naming the app and a contact,
# e.g. Stress Test Review App (you@example.com)
BASECAMP_USER_AGENT=

# Optional (default shown): per-request timeout in seconds, 1-60
BASECAMP_TIMEOUT_S=15

# --- Basecamp OAuth app registration (only for backend/scripts/basecamp_oauth_setup.py) ---
# From launchpad.37signals.com/integrations. The redirect URI must match the
# registration exactly and be http://localhost:<port>/... for the setup script.
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=http://localhost:8765/basecamp/oauth/callback
# Written by the setup script; kept for refreshing the access token later.
BASECAMP_REFRESH_TOKEN=

# --- Posting final feedback to Basecamp (STORY-006). Read by backend/app/posting/config.py ---
# yes = post to the real Basecamp. Keep "no" until STORY-014 (Basecamp sign-in) is done.
BASECAMP_POSTING_ENABLED=no
# Comma-separated Basecamp project ids feedback may be posted into (from the project URL
# .../projects/<id>). Empty = none allowed. Put real ids in .env only.
BASECAMP_POSTING_PROJECT_IDS=
# Upper bound for one posting request, all attempts included, seconds (5-300)
BASECAMP_POSTING_TIME_LIMIT_S=60

# --- Claude API for AI draft evaluations (REQ-005). Read by backend/app/evaluation/config.py ---
# From the Anthropic Console. Required for live evaluations; tests never use it.
ANTHROPIC_API_KEY=
# Optional (defaults shown)
EVALUATION_MODEL=claude-sonnet-5
# low or medium
EVALUATION_EFFORT=low
# Per attempt, seconds (10-300); at most 2 retries (0-2)
EVALUATION_TIMEOUT_S=60
EVALUATION_MAX_RETRIES=2
# Output cap per call, thinking included (500-16000)
EVALUATION_MAX_TOKENS=4000
# A submission above this many input tokens goes to manual resolution
EVALUATION_MAX_INPUT_TOKENS=20000
# All tokens (input, cache, output) per UTC day, across all evaluations
EVALUATION_DAILY_TOKEN_LIMIT=300000

# --- Historical retrieval (REQ-019, STORY-013). Read by backend/app/history/config.py ---
# No key needed: embeddings run locally. Optional (defaults shown)
# How many similar past reviews Claude sees (1-15)
HISTORY_TOP_K=10
# Where the vector index lives; keep it git-ignored (it holds student text)
HISTORY_INDEX_DIR=data/vector_index
